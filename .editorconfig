root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{Makefile,*.mk}]
indent_style = tab

# What rustfmt, Gradle, Xcode and the .NET project already use here.
[*.{rs,toml,kt,kts,gradle,java,swift,cs,csproj,js}]
indent_size = 4
