<?xml version="1.0" encoding="utf-8"?>
<!--
  The Meta Horizon OS flavour. What it adds to the shared manifest is two ways to show the machine:
  a scene in the room, and a system window.

  `ImmersiveActivity` owns the scene and hosts `MainActivity` in a panel, so the machine itself is
  the same activity the phone and the television run. `FlatActivity` is that activity again, in a
  window and a process of its own. `EntryActivity` picks between them. The merger folds this into
  `src/main/AndroidManifest.xml`, which keeps everything else about `MainActivity` written once.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Horizon OS grants no passthrough layer to an application that does not declare this, and
         grants it silently: the scene draws a black void and nothing in the log names the manifest.
         `required` is false because the machine is worth running on a headset without it. -->
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false" />

    <!-- **Hands, or Horizon OS refuses to start an immersive application with no controller awake.**
         The refusal is a system dialog reading `app_launch_blocked_controller_required`, and nothing
         reaches the application. Declaring hands is also the honest answer for this machine: the
         keypad is a thing somebody points at, and a controller is the remote a room already has. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

    <!-- The room the headset scanned, which is what puts the screen on a wall and brings it back
         where the wearer left it. Horizon OS asks the wearer. A refusal costs only the wall, and
         the screen still moves by hand. -->
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />

    <!-- The configuration lets the queue panel's WebView reach the machine's own remote over
         loopback, and nothing else. See the file for why cleartext needs saying at all. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />
        <!-- The scene keeps running while a system panel is in front of it, rather than being
             paused. Without it the machine stops the song to show somebody a settings dialog. -->
        <meta-data
            android:name="com.oculus.vr.focusaware"
            android:value="true" />
        <meta-data
            android:name="com.oculus.handtracking.version"
            android:value="V2.0" />

        <!-- The way in: the library tile and an opened `.kmpkg` both land here, and it hands on to
             the mode last used or to the machine already running. It carries the 2D category, as
             Meta's hybrid sample does, and shows nothing. See EntryActivity.kt. -->
        <activity
            android:name=".EntryActivity"
            android:label="@string/app_name_launcher"
            android:icon="@mipmap/ic_launcher"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.2D" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The two `.kmpkg` routes `MainActivity` carries on a phone. On a headset they end
                 here, so a file finds the machine already running rather than starting another. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-km-package" />
                <data android:scheme="file" android:mimeType="application/x-km-package" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The scene, which hosts the machine on a panel in the room. `EntryActivity` or the flat
             window's button starts it, so it carries no launcher category of its own. -->
        <activity
            android:name=".ImmersiveActivity"
            android:label="@string/app_name_launcher"
            android:icon="@mipmap/ic_launcher"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The machine, hosted in a panel rather than launched from a tile. `allowEmbedded` is what
             lets a scene put an activity on one, and the panel is a virtual display, so the activity
             has to accept a size it did not choose. Its filters move to `EntryActivity`, so nothing
             but the scene and `EntryActivity` ever starts it. -->
        <activity
            android:name=".MainActivity"
            android:allowEmbedded="true"
            android:resizeableActivity="true">
            <intent-filter tools:node="removeAll" />
        </activity>

        <!-- The machine in a system window, in a process of its own. SDL starts the machine once per
             process, and the scene's process has already started one. See Modes.kt. The rest
             repeats `MainActivity` in src/main, because a manifest entry is not inherited. -->
        <activity
            android:name=".FlatActivity"
            android:process=":flat"
            android:label="@string/app_name_launcher"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:screenOrientation="userLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false" />
    </application>

</manifest>
