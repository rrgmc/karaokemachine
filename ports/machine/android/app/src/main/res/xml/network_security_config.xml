<?xml version="1.0" encoding="utf-8"?>
<!--
    Permits plain HTTP to loopback, and to nothing else.

    Both flavours show the machine's own remote in a WebView: the queue panel beside the screen on a
    headset, and the overlay over the screen on a phone. The machine serves that page as plain HTTP
    in this same process. Android blocks cleartext by default, and that block covers `127.0.0.1` as
    well. Without this exception the page stays blank and says nothing about why.

    **Only the WebView needs it.** The machine's own sockets are native and this policy does not
    reach them, so there is no reason to permit cleartext to the LAN. The remote's application
    carries the same file for the same reason.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
