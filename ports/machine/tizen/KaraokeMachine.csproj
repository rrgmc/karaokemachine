<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The karaoke machine on a Samsung Tizen television. Built by tools/port/machine/tizen/package.sh,
    which passes the three things this project does not hold itself:

      KmLibrary    the machine, libkm_app.so, built by build.sh with `app` (goes to lib/)
      KmAssets     the staged asset tree: bank, font, wallpapers (goes to res/assets/)
      KmIcon       the application icon (goes to shared/res/)

    and the manifest with the release's version written in, as TizenManifestFile.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-tizen8.0</TargetFramework>
    <AssemblyName>KaraokeMachine</AssemblyName>
    <RootNamespace>KaraokeMachine</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(KmLibrary)' != ''">
    <TizenTpkUserIncludeFiles Include="$(KmLibrary)">
      <TizenTpkSubDir>lib</TizenTpkSubDir>
      <TizenTpkFileName>libkm_app.so</TizenTpkFileName>
    </TizenTpkUserIncludeFiles>
  </ItemGroup>
  <ItemGroup Condition="'$(KmAssets)' != ''">
    <TizenTpkUserIncludeFiles Include="$(KmAssets)\**\*">
      <TizenTpkSubDir>res\assets\%(RecursiveDir)</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
  </ItemGroup>
  <ItemGroup Condition="'$(KmIcon)' != ''">
    <TizenTpkUserIncludeFiles Include="$(KmIcon)">
      <TizenTpkSubDir>shared\res</TizenTpkSubDir>
      <TizenTpkFileName>karaokemachine.png</TizenTpkFileName>
    </TizenTpkUserIncludeFiles>
  </ItemGroup>
</Project>
