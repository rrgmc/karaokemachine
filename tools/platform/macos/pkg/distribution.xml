<?xml version="1.0" encoding="utf-8"?>
<!--
  The setup program's outline: what the Installer shows, what it offers to leave out, and which
  component package answers each tick.

  Compiled by tools/platform/macos/installer.sh, which is the only thing that should use it — that script
  stages the payload, builds the five component packages, reads the version out of a binary and
  substitutes the two placeholders below. @VERSION@ is the workspace version; @ARCHS@ is asked of
  the staged executable with `lipo -archs`, never of a flag.

  **This file names the choices; the driver names the files.** The claim table in installer.sh is
  what decides which payload entry lands in which component package, and it is also what builds the
  staging roots — so a file arriving in dist/bin/macos that nothing claims fails the build instead
  of being silently left out of the setup. That is the same rule tools/dist/bin.sh applies one level
  down, and the same one tools/platform/windows/installer.iss states for the .iss.

  **System domain, and that is the opposite of what the Windows installer chose for the same
  reason.** There, everything configured beyond the files is per-user — the .kmbuild association
  goes to HKCU\Software\Classes and the PATH entry to HKCU\Environment — so a machine-wide install
  would place files every account can see and configure them for exactly one. Here the identical
  argument lands the other way: the association is declared by a bundle sitting in /Applications and
  the "PATH entry" is a symlink in /usr/local/bin, and both of those are machine-wide by convention.
  One administrator prompt is what that costs, and on macOS it is what every installer does.
-->
<installer-gui-script minSpecVersion="2">
    <title>KaraokeMachine</title>
    <organization>com.rrgmc</organization>

    <!-- `customize="always"` opens on the component list rather than hiding it behind a Customize
         button. This is the macOS answer to Inno's [Components] page, and a person who never finds
         that button installs 150 MB they may not have wanted — the whole point of the components
         is that somebody who wants only the remote pays for neither the instrument bank nor the
         video libraries.

         `require-scripts="true"` makes a failed postinstall a failed install. Two of the three
         scripts are what put a command on the PATH, and a machine with no /usr/local/bin entry is a
         silent half-install; the third is explicitly non-fatal in its own body. -->
    <options customize="always" require-scripts="true" hostArchitectures="@ARCHS@"/>

    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <!-- Declarative rather than an `<installation-check script="...">`: JavaScript in a Distribution
         is deprecated and increasingly disabled, and there is nothing to compute. 11.0 is exactly
         what all three Info.plists declare in LSMinimumSystemVersion, and installer.sh asserts that
         this number and that one still agree rather than trusting them to. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="machine"/>
        <line choice="builder"/>
        <line choice="simple"/>
        <line choice="remote"/>
        <line choice="admin"/>
        <line choice="tools"/>
        <line choice="soundfont"/>
        <line choice="docs"/>
    </choices-outline>

    <choice id="machine" visible="true" start_selected="true" start_enabled="true"
            title="KaraokeMachine"
            description="Plays the songs. Carries the instrument bank and the wallpapers, which is most of the size.">
        <pkg-ref id="com.rrgmc.karaokemachine.machine"/>
    </choice>
    <choice id="builder" visible="true" start_selected="true" start_enabled="true"
            title="KM Package Builder"
            description="Turns a folder of songs into a package. Opens .kmbuild corpus files.">
        <pkg-ref id="com.rrgmc.karaokemachine.builder"/>
    </choice>
    <choice id="simple" visible="true" start_selected="true" start_enabled="true"
            title="KM Simple Package"
            description="Makes a package straight from a folder of songs, in one step. Its packages are marked uncurated.">
        <pkg-ref id="com.rrgmc.karaokemachine.simple"/>
    </choice>
    <choice id="remote" visible="true" start_selected="true" start_enabled="true"
            title="KM Remote"
            description="Search and queue from this computer, with your own copy of the song list.">
        <pkg-ref id="com.rrgmc.karaokemachine.remote"/>
    </choice>
    <choice id="admin" visible="true" start_selected="true" start_enabled="true"
            title="KM Admin"
            description="Finds pictures and instrument banks for the machine, and sends them to it.">
        <pkg-ref id="com.rrgmc.karaokemachine.admin"/>
    </choice>
    <!-- All seven commands, not three: on macOS the two package builders, the remote and Assets each have a
         terminal form as well as an application, and this is the tick that installs it. That is a
         real difference from Windows, where one tick gives both because everything lands in one
         folder. -->
    <choice id="tools" visible="true" start_selected="true" start_enabled="true"
            title="Command-line tools"
            description="km-pack, km-lyrics, km-wallpaper-pack, and the terminal forms of the two package builders, the remote and Assets. Installed in /usr/local/bin.">
        <pkg-ref id="com.rrgmc.karaokemachine.tools"/>
    </choice>
    <!-- **The one choice that installs no files.** Its component package is built with pkgbuild's
         `nopayload` flag, and its whole content is a postinstall that writes down which instrument
         bank was asked for; the download happens on the machine's first start, not here. This
         package still fetches nothing, which is what `What setup fetches` in
         docs/decisions/distribution.md says of it.

         Ticked by default, and the size and the terms are both in the description rather than only
         the size: the recommended bank's license is one this project rates doubtful, and
         `Where a bank may be fetched from` requires the terms beside any offer to fetch it. A person
         declining this should be declining something they have been told the cost of. -->
    <choice id="soundfont" visible="true" start_selected="true" start_enabled="true"
            title="Download the recommended instrument bank on first start"
            description="KaraokeMachine downloads @BANK_NAME@ (@BANK_SIZE@) the first time it runs, and plays it instead of the smaller bundled bank. Nothing is downloaded by this installer. License: @BANK_LICENSE@">
        <pkg-ref id="com.rrgmc.karaokemachine.soundfont"/>
    </choice>
    <!-- The READMEs and the uninstaller. Unconditional, exactly as the .iss's README lines are: a
         few kilobytes, and how somebody finds out the other components exist — plus the only way to
         take any of this off again, which must not be something you could decline. -->
    <choice id="docs" visible="false" start_selected="true" enabled="false"
            title="Documentation and the uninstaller">
        <pkg-ref id="com.rrgmc.karaokemachine.docs"/>
    </choice>

    <pkg-ref id="com.rrgmc.karaokemachine.machine" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-machine.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.builder" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-builder.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.simple" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-simple.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.remote" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-remote.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.admin" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-admin.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.tools" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-tools.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.soundfont" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-soundfont.pkg</pkg-ref>
    <pkg-ref id="com.rrgmc.karaokemachine.docs" version="@VERSION@"
             auth="Root" onConclusion="None">#karaokemachine-docs.pkg</pkg-ref>
</installer-gui-script>
